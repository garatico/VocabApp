# Dependencies
node_modules/
.npm

# Environment
.env
.env.local
.env.*.local

# Database runtime files (keep vocabulary.db, ignore WAL/SHM and backups)
data/*.db-shm
data/*.db-wal
data/*.db.bak
data/curated/*.bak
data/curated/*.tmp

# Written by every pipeline run: rotated backups of the curated files and the
# database, and a transcript per run. Both are local safety nets, not sources.
data/.backups/
data/.logs/

# Logs
*.log
npm-debug.log*

# OS
.DS_Store
Thumbs.db
desktop.ini
.fuse_hidden*

# Editor
#
# `.vscode/*` and not `.vscode/`: git will not re-include a file whose parent
# directory is excluded, so the negations below are dead under the directory
# form. The shared run configurations are project setup rather than personal
# preference — without them "just press play" depends on whichever interpreter
# each machine happens to have selected.
.vscode/*
!.vscode/launch.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/extensions.json
.idea/
*.suo
*.user

# Build / temp
dist/
build/
tmp/
coverage/

# Playwright e2e output — traces/screenshots from failed runs and the HTML
# report, regenerated on every `npm run test:e2e`.
test-results/
playwright-report/
blob-report/
__pycache__/
.pytest_cache/
.ruff_cache/
.venv/
*.pyc
*.pyo
vite.config.js.timestamp-*

# Husky internals
.husky/_/

# data
wikipedia_freq_corpora/
opensubtitles_freq_corpora/
data/old_json/
data/old_jsonl/
data/gloss_cache/
data/vocabulary_1.db

# src
src_old/

# Scratch archives used while shuffling files around (e.g. the backend/data
# split) — not sources anything reads from.
_transfer/

# Mobile app (parked — not in active development; its node_modules is covered
# by the node_modules/ rule above. The app's own sources are still tracked.)

# Generated by `npm run export:vocab` — derived from data/vocabulary.db,
# rebuilt on demand, and 3.6 MB of churn if committed.
public/data/

# Staged by `npm run build:web` from data/ — 27 MB of copies, rebuilt on demand
public/images/
public/emoji/
public/svgs/

# Native build output
# Tauri build output and generated files.
# NOTE: comments must be on their own line — gitignore has no trailing-comment
# syntax, so "src-tauri/icons/  # foo" is a pattern that matches nothing.
src-tauri/target/
# regenerated by `tauri icon` from public/icons/icon-512.png
src-tauri/icons/
# schema/capability files Tauri regenerates on every build
src-tauri/gen/
android/
