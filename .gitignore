# Dependencies
node_modules/
.npm

# Environment
.env
.env.local
.env.*.local

# Database runtime files (keep vocabulary.db, ignore WAL/SHM and backups)
data/*.db-shm
data/*.db-wal
data/*.db.bak
data/curated/*.bak
data/curated/*.tmp

# Logs
*.log
npm-debug.log*

# OS
.DS_Store
Thumbs.db
desktop.ini
.fuse_hidden*

# Editor
.vscode/
.idea/
*.suo
*.user

# Build / temp
dist/
build/
tmp/
coverage/
__pycache__/
*.pyc
*.pyo
vite.config.js.timestamp-*

# Husky internals
.husky/_/

# data
wikipedia_freq_corpora/
opensubtitles_freq_corpora/
data/old_json/
data/old_jsonl/
data/gloss_cache/

# src
src_old/

# Mobile app (parked — not in active development; its node_modules is covered
# by the node_modules/ rule above. The app's own sources are still tracked.)

# Generated by `npm run export:vocab` — derived from data/vocabulary.db,
# rebuilt on demand, and 3.6 MB of churn if committed.
public/data/

# Staged by `npm run build:web` from data/ — 27 MB of copies, rebuilt on demand
public/images/
public/emoji/
public/svgs/

# Native build output
# Tauri build output and generated files.
# NOTE: comments must be on their own line — gitignore has no trailing-comment
# syntax, so "src-tauri/icons/  # foo" is a pattern that matches nothing.
src-tauri/target/
# regenerated by `tauri icon` from public/icons/icon-512.png
src-tauri/icons/
# schema/capability files Tauri regenerates on every build
src-tauri/gen/
android/
