{"rank": 6, "word": "el", "display": "the", "pos": "article", "difficulty": "A1", "tags": ["hardcoded", "function_word", "curated"], "notes": "Definite article masculine singular. Contracts with 'a' → 'al', with 'de' → 'del'. Do not confuse with él (he) — no accent mark on article.", "glosses": ["the"], "examples": [{"es": "El tren llega a las ocho.", "en": "The train arrives at eight."}], "linguistic": {"infinitive": null, "reflexive": null, "gender": null, "plural": null, "register": "neutral", "ipa": "/el/", "syllables": ["el"], "conjugations": null, "irregular": false}, "relations": {"commonly_confused_with": [], "related": [], "synonyms": [], "antonyms": []}, "frequency": {"band": "A1", "rank": 6, "corpus_frequency": 7531226}, "domains": ["essential"], "register": "neutral", "lang": "spanish", "source": "hardcoded", "needs_review": false}
