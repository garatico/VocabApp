{"rank": 319, "word": "fuerte", "display": "strong", "pos": "adjective", "difficulty": "A2", "tags": ["curated"], "notes": "Adjective/adverb 'strong/loud/hard'. Un abrazo muy fuerte = a big hug. Hablar fuerte = to speak loudly. Punto fuerte = strong point. Lo fuerte es = the incredible thing is.", "glosses": ["strong", "tough", "loud"], "examples": [{"es": "Necesitas ser fuerte en este momento.", "en": "You need to be strong right now."}, {"es": "El viento es muy fuerte hoy.", "en": "The wind is very strong today."}], "linguistic": {"infinitive": null, "reflexive": null, "gender": null, "plural": null, "register": "neutral", "ipa": "/ˈfweɾ.te/", "syllables": ["fuer", "te"], "conjugations": null, "irregular": false}, "relations": {"commonly_confused_with": [], "related": [], "synonyms": [], "antonyms": []}, "frequency": {"band": "B1", "rank": 355, "corpus_frequency": 90226}, "domains": ["general"], "register": "neutral", "lang": "spanish", "source": "curated", "needs_review": false}
