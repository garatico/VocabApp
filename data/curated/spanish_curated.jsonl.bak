{"rank": 1222, "word": "entrada", "display": "entrance / entry", "pos": "noun", "difficulty": "A2", "tags": ["curated"], "notes": "Entrada principal = main entrance. Precio de entrada = admission price. Entrada gratuita = free entry. Also a ticket: comprar entradas = to buy tickets. Antonym: salida (exit).", "glosses": ["entrance", "entry", "ticket", "admission", "input"], "examples": [{"es": "La entrada al museo es gratuita los domingos.", "en": "Entry to the museum is free on Sundays."}], "linguistic": {"infinitive": null, "gender": "f", "plural": "entradas", "conjugations": null, "irregular": false, "register": "neutral", "reflexive": null, "ipa": "", "syllables": []}, "relations": {"commonly_confused_with": [], "related": ["entrar", "salida", "acceso"], "synonyms": [], "antonyms": ["salida"]}, "frequency": {"corpus_frequency": 26809, "band": "A2"}, "domains": ["everyday", "architecture", "events"], "register": "neutral", "lang": "spanish", "source": "curated", "needs_review": false}
