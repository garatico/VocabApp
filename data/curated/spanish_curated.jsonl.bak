{"rank": 1, "word": "de", "display": "of", "pos": "preposition", "difficulty": "A1", "tags": ["hardcoded", "function_word", "curated"], "notes": "Most frequent Spanish word. Primary preposition of possession, origin, material, and partitive. Combines with 'el' → 'del'. Core to countless fixed phrases: de nada, de verdad, de repente.", "glosses": ["of", "from"], "examples": [{"es": "El libro de María está en la mesa.", "en": "María's book is on the table."}], "linguistic": {"infinitive": null, "reflexive": null, "gender": null, "plural": null, "register": "neutral", "ipa": "/de/", "syllables": ["de"], "conjugations": null, "irregular": false}, "relations": {"commonly_confused_with": [], "related": [], "synonyms": [], "antonyms": []}, "frequency": {"band": "A1", "rank": 1, "corpus_frequency": 14459520}, "domains": ["essential"], "register": "neutral", "lang": "spanish", "source": "hardcoded", "needs_review": false}
{"rank": 2, "word": "que", "display": "that", "pos": "conjunction", "difficulty": "A1", "tags": ["hardcoded", "function_word", "curated"], "notes": "Subordinating conjunction 'that' and relative pronoun 'who/which/that'. Essential connector: creo que, es que, lo que. Elides in speech but never in writing.", "glosses": ["that", "which", "who"], "examples": [{"es": "Creo que tienes razón.", "en": "I think you're right."}], "linguistic": {"infinitive": null, "reflexive": null, "gender": null, "plural": null, "register": "neutral", "ipa": "/ke/", "syllables": ["que"], "conjugations": null, "irregular": false}, "relations": {"commonly_confused_with": [], "related": [], "synonyms": [], "antonyms": []}, "frequency": {"band": "A1", "rank": 2, "corpus_frequency": 14421005}, "domains": ["essential"], "register": "neutral", "lang": "spanish", "source": "hardcoded", "needs_review": false}
{"rank": 3, "word": "no", "display": "not", "pos": "adverb", "difficulty": "A1", "tags": ["hardcoded", "function_word", "curated"], "notes": "Primary negation word. Placed before verb: no sé, no quiero. Doubled for emphasis: no, no. Also used in tag questions: ¿verdad que no?", "glosses": ["no", "not"], "examples": [{"es": "No entiendo lo que dices.", "en": "I don't understand what you're saying."}], "linguistic": {"infinitive": null, "reflexive": null, "gender": null, "plural": null, "register": "neutral", "ipa": "/no/", "syllables": ["no"], "conjugations": null, "irregular": false}, "relations": {"commonly_confused_with": [], "related": [], "synonyms": [], "antonyms": []}, "frequency": {"band": "A1", "rank": 3, "corpus_frequency": 12379505}, "domains": ["essential"], "register": "neutral", "lang": "spanish", "source": "hardcoded", "needs_review": false}
{"rank": 4, "word": "a", "display": "to", "pos": "preposition", "difficulty": "A1", "tags": ["hardcoded", "function_word", "curated"], "notes": "Preposition of direction, destination, and the personal 'a' before animate direct objects. Contracts with 'el' → 'al'. Also marks indirect objects.", "glosses": ["to", "at"], "examples": [{"es": "Voy a la tienda a las tres.", "en": "I'm going to the store at three."}], "linguistic": {"infinitive": null, "reflexive": null, "gender": null, "plural": null, "register": "neutral", "ipa": "/a/", "syllables": ["a"], "conjugations": null, "irregular": false}, "relations": {"commonly_confused_with": [], "related": [], "synonyms": [], "antonyms": []}, "frequency": {"band": "A1", "rank": 4, "corpus_frequency": 9549646}, "domains": ["essential"], "register": "neutral", "lang": "spanish", "source": "hardcoded", "needs_review": false}
