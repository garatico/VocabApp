{"rank": 311, "word": "posible", "display": "possible", "pos": "adjective", "difficulty": "A2", "tags": ["curated"], "notes": "Adjective 'possible'. Es posible que + subj = it's possible that. Lo antes posible = as soon as possible. En la medida de lo posible = as much as possible.", "glosses": ["possible"], "examples": [{"es": "¿Es posible cambiar la fecha?", "en": "Is it possible to change the date?"}, {"es": "Haz todo lo posible para ayudarle.", "en": "Do everything possible to help him."}], "linguistic": {"infinitive": null, "reflexive": null, "gender": null, "plural": null, "register": "neutral", "ipa": "/poˈsi.βle/", "syllables": ["po", "si", "ble"], "conjugations": null, "irregular": false}, "relations": {"commonly_confused_with": [], "related": [], "synonyms": [], "antonyms": []}, "frequency": {"band": "A2", "rank": 351, "corpus_frequency": 92449}, "domains": ["general"], "register": "neutral", "lang": "spanish", "source": "curated", "needs_review": false}
{"rank": 312, "word": "hermana", "display": "sister", "pos": "noun", "difficulty": "A1", "tags": ["curated"], "notes": "Feminine noun 'sister'. Hermana mayor/menor = older/younger sister. Medio hermana = half-sister. Hermanas = sisters. Hermano/hermana also used among friends in L.Am.", "glosses": ["sister"], "examples": [{"es": "Mi hermana pequeña tiene diez años.", "en": "My younger sister is ten years old."}], "linguistic": {"infinitive": null, "reflexive": null, "gender": "feminine", "plural": "hermanas", "register": "neutral", "ipa": "/eɾˈma.na/", "syllables": ["her", "ma", "na"], "conjugations": null, "irregular": false}, "relations": {"commonly_confused_with": [], "related": [], "synonyms": [], "antonyms": []}, "frequency": {"band": "A2", "rank": 352, "corpus_frequency": 92291}, "domains": ["general", "family"], "register": "neutral", "lang": "spanish", "source": "curated", "needs_review": false}
{"rank": 313, "word": "número", "display": "number", "pos": "noun", "difficulty": "A2", "tags": ["curated"], "notes": "Masculine noun 'number'. El primer número = the first issue (magazine). Número de teléfono. Número uno = number one. Sin número = countless. Montar un número = to make a scene.", "glosses": ["number"], "examples": [{"es": "Escribe tu número de teléfono aquí.", "en": "Write your phone number here."}], "linguistic": {"infinitive": null, "reflexive": null, "gender": "masculine", "plural": "números", "register": "neutral", "ipa": "/ˈnu.me.ɾo/", "syllables": ["nú", "me", "ro"], "conjugations": null, "irregular": false}, "relations": {"commonly_confused_with": [], "related": [], "synonyms": [], "antonyms": []}, "frequency": {"band": "A2", "rank": 230, "corpus_frequency": 92183}, "domains": ["general"], "register": "neutral", "lang": "spanish", "source": "curated", "needs_review": false}
