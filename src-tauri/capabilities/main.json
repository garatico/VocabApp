{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-capability",
  "description": "Local SQLite access for the embedded vocabulary db, and the narrow filesystem access needed to copy it from the bundled resource into the app's writable data dir on first launch, and again when the installer carries newer data. Plus the app's automatic backup: one folder, Documents/VocabApp, read and written so a backup survives an uninstall (utils/auto-backup.ts).",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:path:default",
    "core:path:allow-resolve-directory",
    "core:webview:allow-set-webview-zoom",
    "core:window:allow-set-theme",
    "sql:default",
    "sql:allow-execute",
    {
      "identifier": "fs:allow-exists",
      "allow": [
        {
          "path": "$APPDATA"
        },
        {
          "path": "$APPDATA/**"
        },
        {
          "path": "$DOCUMENT/VocabApp"
        },
        {
          "path": "$DOCUMENT/VocabApp/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-mkdir",
      "allow": [
        {
          "path": "$APPDATA"
        },
        {
          "path": "$APPDATA/**"
        },
        {
          "path": "$DOCUMENT/VocabApp"
        },
        {
          "path": "$DOCUMENT/VocabApp/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-remove",
      "allow": [
        {
          "path": "$APPDATA"
        },
        {
          "path": "$APPDATA/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-copy-file",
      "allow": [
        {
          "path": "$RESOURCE/**"
        },
        {
          "path": "$APPDATA"
        },
        {
          "path": "$APPDATA/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-read-text-file",
      "allow": [
        {
          "path": "$DOCUMENT/VocabApp/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-write-text-file",
      "allow": [
        {
          "path": "$DOCUMENT/VocabApp/**"
        }
      ]
    }
  ]
}
