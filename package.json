{
  "name": "vocab-app",
  "version": "0.1.0",
  "description": "Vocabulary learning app — Express API, SQLite, Vite SPA",
  "private": true,
  "type": "module",
  "main": "src/server/index.ts",
  "scripts": {
    "start": "tsx src/server/index.ts",
    "dev": "concurrently -n \"api,vite\" -c \"cyan,magenta\" \"npm run dev:api\" \"npm run dev:fe\"",
    "dev:api": "cross-env NODE_ENV=development PORT=3000 tsx watch src/server/index.ts",
    "prepare": "husky",
    "dev:fe": "vite",
    "dev:admin": "cross-env NODE_ENV=development PORT=3000 tsx src/server/index.ts",
    "build": "vite build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint src/ tests/ scripts/",
    "typecheck": "tsc --noEmit && tsc --noEmit -p config/tsconfig.server.json && tsc --noEmit -p config/tsconfig.e2e.json",
    "typecheck:client": "tsc --noEmit",
    "typecheck:server": "tsc --noEmit -p config/tsconfig.server.json",
    "typecheck:e2e": "tsc --noEmit -p config/tsconfig.e2e.json",
    "validate": "node scripts/validate.js",
    "export:vocab": "tsx scripts/export-static-vocab.ts",
    "data:sync": "tsx scripts/sync-data.ts",
    "native:check": "tsx scripts/build-native.ts check",
    "build:web": "tsx scripts/build-native.ts web",
    "build:windows": "tsx scripts/build-native.ts windows",
    "build:android": "tsx scripts/build-native.ts android",
    "build:native": "tsx scripts/build-native.ts native"
  },
  "dependencies": {
    "@mlc-ai/web-llm": "^0.2.84",
    "better-sqlite3": "^9.2.2",
    "compression": "^1.8.1",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.2.0",
    "tsx": "^4.19.0",
    "wanakana": "^5.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tauri-apps/cli": "^2.11.4",
    "@types/better-sqlite3": "^7.6.8",
    "@types/compression": "^1.7.5",
    "@types/express": "^4.17.21",
    "@types/node": "^26.5.0",
    "@vitest/coverage-v8": "^5.0.0",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "eslint": "^10.10.0",
    "flag-icons": "^7.5.0",
    "husky": "^9.0.0",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.5.0",
    "sql.js": "^1.14.2",
    "supertest": "^7.2.2",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "qs": "^6.16.0"
  },
  "lint-staged": {
    "*.{ts,js}": "eslint"
  }
}
