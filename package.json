{
  "name": "vocab-app",
  "version": "0.1.0",
  "description": "Vocabulary learning app — Express API, SQLite, Vite SPA",
  "private": true,
  "type": "module",
  "main": "src/server/index.ts",
  "scripts": {
    "start": "tsx src/server/index.ts",
    "dev": "concurrently -n \"api,vite\" -c \"cyan,magenta\" \"npm run dev:api\" \"npm run dev:fe\"",
    "dev:api": "cross-env NODE_ENV=development tsx watch src/server/index.ts",
    "prepare": "husky",
    "dev:fe": "vite",
    "dev:admin": "cross-env NODE_ENV=development tsx src/server/index.ts",
    "build": "vite build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "eslint src/ tests/ scripts/",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json",
    "typecheck:client": "tsc --noEmit",
    "typecheck:server": "tsc --noEmit -p tsconfig.server.json",
    "validate": "node scripts/validate.js",
    "sync": "cp data/vocabulary.db data/vocabulary.db.bak && python3 scripts/data/sync_db.py",
    "sync:dry": "python3 scripts/data/sync_db.py --dry-run",
    "download:images": "python3 scripts/data/download_images.py",
    "download:emoji": "python3 scripts/data/download_emoji.py",
    "check:visuals": "python3 scripts/data/check_visual_coverage.py",
    "check:visuals:animals": "python3 scripts/data/check_visual_coverage.py --domain animals",
    "check:visuals:food": "python3 scripts/data/check_visual_coverage.py --domain food"
  },
  "dependencies": {
    "better-sqlite3": "^9.2.2",
    "compression": "^1.8.1",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.8",
    "@types/compression": "^1.7.5",
    "@types/express": "^4.17.21",
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^4.1.6",
    "concurrently": "^9.0.0",
    "cross-env": "^7.0.3",
    "eslint": "^10.3.0",
    "husky": "^9.0.0",
    "lint-staged": "^16.4.0",
    "sql.js": "^1.14.1",
    "supertest": "^7.2.2",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.61.0",
    "vite": "^5.4.0",
    "vitest": "^4.1.6"
  },
  "engines": {
    "node": ">=20"
  },
  "lint-staged": {
    "*.{ts,js}": "eslint"
  }
}
