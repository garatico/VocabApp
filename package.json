{
  "name": "vocab-app",
  "version": "0.1.0",
  "description": "Vocabulary learning app — Express API, SQLite, Vite SPA",
  "private": true,
  "type": "module",
  "main": "src/server/index.ts",
  "scripts": {
    "start": "tsx src/server/index.ts",
    "dev": "concurrently -n \"api,vite\" -c \"cyan,magenta\" \"npm run dev:api\" \"npm run dev:fe\"",
    "dev:api": "cross-env NODE_ENV=development PORT=3000 tsx watch src/server/index.ts",
    "prepare": "husky",
    "dev:fe": "vite",
    "dev:admin": "cross-env NODE_ENV=development PORT=3000 tsx src/server/index.ts",
    "build": "vite build",
    "build:static": "tsx scripts/build-static.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint src/ tests/ scripts/",
    "typecheck": "node node_modules/typescript-7/bin/tsc --noEmit && node node_modules/typescript-7/bin/tsc --noEmit -p config/tsconfig.server.json && node node_modules/typescript-7/bin/tsc --noEmit -p config/tsconfig.e2e.json",
    "typecheck:client": "node node_modules/typescript-7/bin/tsc --noEmit",
    "typecheck:server": "node node_modules/typescript-7/bin/tsc --noEmit -p config/tsconfig.server.json",
    "typecheck:e2e": "node node_modules/typescript-7/bin/tsc --noEmit -p config/tsconfig.e2e.json",
    "validate": "node scripts/validate.js",
    "build:word-editor-css": "node scripts/word-editor-css.mjs",
    "export:vocab": "tsx scripts/export-static-vocab.ts",
    "data:sync": "tsx scripts/sync-data.ts",
    "native:check": "tsx scripts/build-native.ts check",
    "build:web": "tsx scripts/build-native.ts web",
    "build:windows": "tsx scripts/build-native.ts windows",
    "build:android": "tsx scripts/build-native.ts android",
    "build:native": "tsx scripts/build-native.ts native"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/local-notifications": "^8.3.1",
    "@fontsource/dm-mono": "^5.3.0",
    "@fontsource/sora": "^5.3.0",
    "@mlc-ai/web-llm": "0.2.84",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-fs": "^2.5.2",
    "@tauri-apps/plugin-sql": "^2.4.1",
    "better-sqlite3": "^13.0.3",
    "compression": "^1.8.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "tsx": "^4.23.15",
    "wanakana": "^5.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@capacitor/cli": "^8.5.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@tauri-apps/cli": "^2.12.2",
    "@types/better-sqlite3": "^9.6.0",
    "@types/compression": "^1.7.5",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.0.3",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "eslint": "^10.12.0",
    "flag-icons": "^7.5.0",
    "husky": "^9.0.0",
    "jsdom": "^30.1.2",
    "lint-staged": "^17.6.0",
    "sql.js": "^1.14.2",
    "supertest": "^7.3.1",
    "typescript": "^6.0.3",
    "typescript-7": "npm:typescript@^7.0.2",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22.22"
  },
  "overrides": {
    "qs": "^6.16.0",
    "shell-quote": "^1.12.0"
  },
  "lint-staged": {
    "*.{ts,js}": "eslint"
  },
  "optionalDependencies": {
    "sharp": "^0.35.4"
  }
}
