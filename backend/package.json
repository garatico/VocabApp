{
  "name": "vocab-app-backend",
  "version": "0.1.0",
  "description": "Lightweight Express backend for serving vocabulary and admin tools",
  "private": true,
  "type": "module",
  "main": "src/server/index.js",
  "scripts": {
    "start": "node src/server/index.js",
    "dev": "concurrently -n \"api,vite\" -c \"cyan,magenta\" \"npm run dev:api\" \"npm run dev:fe\"",
    "dev:api": "cross-env NODE_ENV=development node --watch src/server/index.js",
    "prepare": "cd .. && npx husky backend/.husky",
    "dev:fe": "vite",
    "dev:admin": "cross-env NODE_ENV=development node src/server/index.js",
    "build": "vite build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "eslint src/server/ src/client/ tests/",
    "typecheck": "tsc --noEmit",
    "validate": "node scripts/validate.js",
    "sync": "python3 scripts/data/sync_db.py",
    "sync:dry": "python3 scripts/data/sync_db.py --dry-run",
    "download:images": "python3 scripts/data/download_images.py",
    "download:emoji": "python3 scripts/data/download_emoji.py",
    "check:visuals": "python3 scripts/data/check_visual_coverage.py",
    "check:visuals:animals": "python3 scripts/data/check_visual_coverage.py --domain animals",
    "check:visuals:food": "python3 scripts/data/check_visual_coverage.py --domain food"
  },
  "dependencies": {
    "better-sqlite3": "^9.2.2",
    "compression": "^1.8.1",
    "dotenv": "^16.3.1",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^9.0.0",
    "cross-env": "^7.0.3",
    "eslint": "^10.3.0",
    "sql.js": "^1.14.1",
    "supertest": "^7.2.2",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vitest": "^4.1.6",
    "@vitest/coverage-v8": "^4.1.6",
    "husky": "^9.0.0"
  },
  "engines": {
    "node": "20.x"
  }
}
