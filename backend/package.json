{
  "name": "vocab-app-backend",
  "version": "0.1.0",
  "description": "Lightweight Express backend for serving vocabulary and admin tools",
  "private": true,
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "npm run validate && node src/index.js",
    "dev": "concurrently -n \"api,vite\" -c \"cyan,magenta\" \"npm run dev:api\" \"npm run dev:fe\"",
    "dev:api": "npm run validate && cross-env NODE_ENV=development node --watch src/index.js",
    "dev:fe": "vite",
    "dev:admin": "cross-env NODE_ENV=development node src/index.js",
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/ public/src/",
    "typecheck": "tsc --noEmit",
    "validate": "node scripts/validate.js"
  },
  "dependencies": {
    "better-sqlite3": "^9.2.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^9.0.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "cross-env": "^7.0.3",
    "eslint": "^10.3.0",
    "nodemon": "^3.0.1",
    "sql.js": "^1.14.1",
    "supertest": "^7.2.2",
    "vitest": "^4.1.6"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
