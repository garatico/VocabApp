# Backend Configuration
# Do not set NODE_ENV here — Vite's dotenv loader copies every key from this
# file into process.env, and an already-set NODE_ENV overrides `vite build`'s
# own production mode, shipping dev-only code (Admin/AI Chat tabs, debug
# logging) into packaged builds. The dev scripts set NODE_ENV themselves via
# cross-env (see package.json's dev:api/dev:admin).
API_PORT=3000
API_BASE_URL=http://localhost:3000

# Admin Protection
# Set ADMIN_SECRET to require Authorization: Bearer <token> on all admin API routes.
# Leave unset for purely local dev (the middleware will pass through with no secret).
# Generate a value with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SECRET=

# CORS
# Comma-separated extra origins allowed in production (e.g. the deployed
# frontend's URL), on top of the hardcoded localhost defaults in
# src/server/middleware/cors.ts. Not used in development, which allows any
# localhost/127.0.0.1 port instead.
CORS_ORIGINS=

# Data Directory
#
# Where vocabulary.db, images/, emoji/ and svgs/ live. This app does not build
# them — VocabApp-Data does — so point this at whatever that project produced.
# It reads the same variable name, which is how one setting keeps producer and
# consumer looking at the same directory. VocabApp-Data lives alongside this
# repo, not nested inside it.
DATA_DIR=../VocabApp-Data/data

# Logging
# Server log verbosity: debug | info | warn | error | silent
# Defaults by NODE_ENV when unset: debug (development), info (production), warn (test).
LOG_LEVEL=
