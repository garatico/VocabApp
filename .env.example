# Backend Configuration
NODE_ENV=development
API_PORT=3000
API_BASE_URL=http://localhost:3000

# Admin Protection
# Set ADMIN_SECRET to require Authorization: Bearer <token> on all admin API routes.
# Leave unset for purely local dev (the middleware will pass through with no secret).
# Generate a value with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SECRET=

# Data Directory
DATA_DIR=./data
